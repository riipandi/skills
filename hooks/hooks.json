{
  "description": "Applies the language rules and the prompt optimizer from the first message, and handles /prompt-optimizer on|off",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.sh\" prompt",
            "timeout": 20,
            "statusMessage": "Sharpening the prompt..."
          }
        ]
      }
    ]
  }
}
